rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Akıllı tahta web ekranı (tahta.html) ve mobil uygulamanın
    // yetki engeline takılmadan senkronize çalışabilmesi için tüm koleksiyonlarda açık erişim
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
